<Window x:Class="Dynapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dynapp"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="Dynapp — Dynamixel Controller" Height="900" Width="1100"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="1200">

            <!-- ===== ヘッダー / 接続バー ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="DYNAPP" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="22" Fill="{StaticResource CardBorderBrush}" Margin="14,0"/>
                        <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}" Width="120"/>
                        <Button Command="{Binding RefreshPortsCommand}" Content="↻" Padding="10,7" Margin="6,0,0,0"
                                ToolTip="ポート一覧を更新"/>
                        <Button Command="{Binding UsbConnectCommand}" Content="CONNECT" Style="{StaticResource AccentButton}" Margin="6,0,0,0"/>
                        <Button Command="{Binding ScanCommand}" Content="SCAN" Margin="6,0,0,0"/>
                        <Button Command="{Binding AllEnableCommand}" Content="ALL ENABLE" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== モーター一覧 ===== -->
            <ItemsControl ItemsSource="{Binding Motors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左: モーターID バッジ -->
                                <Border Grid.Column="0" Background="{StaticResource ControlBgBrush}"
                                        CornerRadius="8" Width="64" Padding="0,8" VerticalAlignment="Center"
                                        Margin="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock Text="MOTOR" FontSize="9" Foreground="{StaticResource TextDimBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Id}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 右: 設定&操作 -->
                                <StackPanel Grid.Column="1">
                                    <!-- 1段目: 設定類 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="ID" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                        <TextBox Text="{Binding Id}" Width="52" Height="30" TextAlignment="Center"/>

                                        <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}" Margin="18,0,6,0"/>
                                        <TextBlock Text="{Binding ModelName}" MinWidth="90" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>

                                        <ComboBox SelectedIndex="{Binding ModeIndex}" Width="150" Margin="18,0,0,0">
                                            <ComboBoxItem Content="Current"/>
                                            <ComboBoxItem Content="Speed"/>
                                            <ComboBoxItem Content="Position"/>
                                            <ComboBoxItem Content="Extended Position"/>
                                        </ComboBox>

                                        <CheckBox Content="LED" IsChecked="{Binding IsLed}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                        <CheckBox Content="ENABLE" IsChecked="{Binding IsEnable}" Margin="14,0,0,0" VerticalAlignment="Center"/>

                                        <Button Command="{Binding RebootCommand}" Content="REBOOT"
                                                Style="{StaticResource DangerOutlineButton}" Padding="10,4" Margin="18,0,0,0"/>
                                    </StackPanel>

                                    <!-- 2段目: ゲイン調整 (Position PID) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="GAIN" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="P" FontSize="9" Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding PositionPGain, UpdateSourceTrigger=LostFocus}"
                                                 Width="64" Height="26" TextAlignment="Center"/>
                                        <TextBlock Text="I" FontSize="9" Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center" Margin="12,0,4,0"/>
                                        <TextBox Text="{Binding PositionIGain, UpdateSourceTrigger=LostFocus}"
                                                 Width="64" Height="26" TextAlignment="Center"/>
                                        <TextBlock Text="D" FontSize="9" Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center" Margin="12,0,4,0"/>
                                        <TextBox Text="{Binding PositionDGain, UpdateSourceTrigger=LostFocus}"
                                                 Width="64" Height="26" TextAlignment="Center"/>
                                        <Button Command="{Binding RefreshGainsCommand}" Content="↻ 読込"
                                                Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center"
                                                ToolTip="モーターから現在のゲイン値を読み込む"/>
                                    </StackPanel>

                                    <!-- 3段目: スライダー&値 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- MIN 制限の入力欄 -->
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="MIN" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBox Text="{Binding SliderMin, UpdateSourceTrigger=LostFocus}"
                                                     Width="72" Height="26" TextAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="A ←" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                                        <Slider Grid.Column="2" VerticalAlignment="Center"
                                                Minimum="{Binding SliderMin}" Maximum="{Binding SliderMax}"
                                                Value="{Binding SliderValue}" PreviewMouseWheel="Slider_PreviewMouseWheel"/>
                                        <TextBlock Grid.Column="3" Text="→ D" Style="{StaticResource FieldLabel}" Margin="10,0,10,0"/>
                                        <!-- MAX 制限の入力欄 -->
                                        <StackPanel Grid.Column="4" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="MAX" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBox Text="{Binding SliderMax, UpdateSourceTrigger=LostFocus}"
                                                     Width="72" Height="26" TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="TARGET" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBlock Text="{Binding TargetValue}" FontWeight="Bold" MinWidth="50"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="NOW" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBlock Text="{Binding NowValue}" FontWeight="Bold" MinWidth="50"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                        <!-- 0に戻すボタン -->
                                        <Button Grid.Column="7" Command="{Binding GoToZeroCommand}" Content="⟲ 0"
                                                Padding="12,4" VerticalAlignment="Center"
                                                ToolTip="目標値を0に戻す"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== スクリプトランナー ===== -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,14">
                <StackPanel>
                    <TextBlock Text="SCRIPT RUNNER" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding LoadScriptCommand}" Content="ファイルを選択"/>
                        <TextBlock Text="{Binding ScriptFileName}" VerticalAlignment="Center" Margin="12,0,24,0"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <Button Command="{Binding RunScriptCommand}" Content="▶ RUN"
                                Style="{StaticResource AccentButton}" Padding="18,7"/>
                        <Button Command="{Binding StopScriptCommand}" Content="■ STOP"
                                Style="{StaticResource DangerButton}" Padding="18,7" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== グラフ ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="GRAPH" Style="{StaticResource CardTitle}"/>
                    <ItemsControl ItemsSource="{Binding Motors}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ControlBgBrush}" CornerRadius="8"
                                        Padding="12,8" Margin="0,0,10,0">
                                    <StackPanel>
                                        <CheckBox Content="{Binding Id, StringFormat=Motor {0}}" IsChecked="{Binding IsShowGraph}"
                                                  FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <CheckBox Content="Current" IsEnabled="{Binding IsShowGraph}"
                                                  IsChecked="{Binding IsShowCurrentGraph}" Margin="0,0,0,4"/>
                                        <CheckBox Content="Position" IsEnabled="{Binding IsShowGraph}"
                                                  IsChecked="{Binding IsShowPositionGraph}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border CornerRadius="8" ClipToBounds="True">
                        <ScottPlot:WpfPlot Name="WpfPlot1" Height="320"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
