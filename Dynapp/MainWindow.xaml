                                                  VerticalAlignment="Center" Margin="0,0,14,0"/>

                                        <!-- 出力モード選択 -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="出力" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                                            <ComboBox SelectedIndex="{Binding ControlModeIndex}" Width="130"
                                                      ToolTip="式の計算結果を、この種別の目標値として書き込みます">
                                                <ComboBoxItem Content="Current(電流)"/>
                                                <ComboBoxItem Content="Velocity(速度)"/>
                                                <ComboBoxItem Content="Position(位置)"/>
                                                <ComboBoxItem Content="Ext Position"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="out =" FontFamily="Consolas" FontSize="14"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding ControlExpressionText, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="320" Height="32" FontFamily="Consolas"
                                                         GotFocus="ExprBox_GotFocus"
                                                         VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ControlStatus}" FontSize="10" Margin="42,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsControlExpressionValid}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF3FB950"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsControlExpressionValid}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- 仮想ゼロ点 -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="ZERO(基準)" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="⌖ ここを0" Command="{Binding SetZeroHereCommand}"
                                                        Padding="8,4" FontSize="11"
                                                        ToolTip="現在地を制御式上の0基準にする(pos がこの位置からの相対値になる)"/>
                                                <Button Content="⟲" Command="{Binding ClearZeroCommand}"
                                                        Padding="8,4" FontSize="11" Margin="4,0,0,0"
                                                        ToolTip="ゼロ基準を解除(生の位置に戻す)"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PositionZeroOffset, StringFormat='基準 {0}'}"
                                                       FontSize="9" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="OUT NOW" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBlock Text="{Binding ControlOutput}" FontWeight="Bold"
                                                       MinWidth="56" Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="ヒント: モーターが未検出のときは『手動モード』タブで CONNECT → SCAN してください。"
                               Style="{StaticResource FieldLabel}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ===== 監視する変数 ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="MONITORS — 監視する変数 (式の値をライブ表示)"
                                   Style="{StaticResource CardTitle}" DockPanel.Dock="Left" Margin="0"/>
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Command="{Binding AddMonitorCommand}" Content="＋ 変数を追加" Padding="12,4"/>
                    </DockPanel>

                    <!-- 見出し行 -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="名前" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Text="式" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="2" Text="現在値" Style="{StaticResource FieldLabel}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DragRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="30" Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBox Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30" FontFamily="Consolas"
                                                     GotFocus="ExprBox_GotFocus"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" Margin="2,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF3FB950"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:0.###}}"
                                                   FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource DragHandle}" Margin="0,0,6,0"/>
                                            <Button Content="✕" Padding="10,4"
                                                    Style="{StaticResource DangerOutlineButton}"
                                                    Command="{Binding DataContext.RemoveMonitorCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
    </TabItem>

    </TabControl>
</Window>
